{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "ax-first가 생성한 settings — hooks 등록은 자동, 나머지는 자기 환경에 맞게",
  "hooks": {
    "preToolUse": [
      {
        "matcher": "Bash",
        "command": ".claude/hooks/pre-bash/block-destructive.sh"
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "command": ".claude/hooks/pre-edit/check-protected-paths.sh"
      }
    ],
    "postToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "command": ".claude/hooks/post-edit/lint-changed.sh"
      }
    ]
  }
}
