#!/usr/bin/env bash
# ax-first doctor — 현재 프로젝트의 하네스 상태 진단
set -euo pipefail
. "${AX_LIB:-$AX_ROOT/lib}/common.sh"
AX_ROOT="${AX_ROOT:?run via ax-first}"

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
score=0
total=0

check() {
    local label="$1" path="$2"
    total=$((total+1))
    if [ -e "$PROJECT_ROOT/$path" ]; then
        printf '  \033[32m✓\033[0m %s\n' "$label"
        score=$((score+1))
    else
        printf '  \033[31m✗\033[0m %s  → %s 없음\n' "$label" "$path"
    fi
}

soft_check() {
    local label="$1" path="$2"
    total=$((total+1))
    if [ -e "$PROJECT_ROOT/$path" ]; then
        printf '  \033[32m✓\033[0m %s\n' "$label"
        score=$((score+1))
    else
        printf '  \033[33m·\033[0m %s  → %s (선택사항)\n' "$label" "$path"
    fi
}

echo "🩺 ax-first doctor — $PROJECT_ROOT"
echo

echo "Layer 1 — Constitution"
check "CLAUDE.md (Constitution)" "CLAUDE.md"

echo
echo "Layer 0 — Triage"
check "triage skill" ".claude/skills/global/triage/SKILL.md"
check "config.yml" ".ax-first/config.yml"

echo
echo "Cross-cut — Mistake Loop"
check "mistakes 디렉토리" ".ax-first/mistakes"
check "steering-loop skill" ".claude/skills/global/steering-loop/SKILL.md"

echo
echo "Sensors — Hooks"
check "pre-bash/block-destructive.sh" ".claude/hooks/pre-bash/block-destructive.sh"
check "post-edit/lint-changed.sh" ".claude/hooks/post-edit/lint-changed.sh"
check "pre-commit/critical-rule-grep.sh" ".claude/hooks/pre-commit/critical-rule-grep.sh"
check ".claude/settings.json (hooks 등록)" ".claude/settings.json"

echo
echo "Layer 3 — Spec / ADR"
soft_check "docs/adr 디렉토리" "docs/adr"
soft_check "ADR 1개 이상" "docs/adr/0001-"

echo
echo "Layer 2 — Module CLAUDE.md (선택사항)"
soft_check "apps/ 모듈 CLAUDE 1개 이상" "apps"

echo
printf '점수: %d / %d\n' "$score" "$total"
if [ "$score" = "$total" ]; then
    printf '\033[32m✓ 완전\033[0m\n'
elif [ "$score" -ge $((total * 7 / 10)) ]; then
    printf '\033[33m· 양호 — 결손 항목 보강 권장\033[0m\n'
else
    printf '\033[31m✗ 부족 — ax-first init [--force] 재실행 또는 누락 항목 직접 추가\033[0m\n'
fi
