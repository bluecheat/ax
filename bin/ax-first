#!/usr/bin/env bash
# ax-first — main CLI dispatcher
set -euo pipefail

VERSION="0.1.0"

# 자기 위치를 파악 — symlink 따라가서 실제 ax-first repo 루트 찾기
RESOLVED_BIN="$(readlink -f "$0" 2>/dev/null || python3 -c "import os,sys; print(os.path.realpath(sys.argv[1]))" "$0")"
AX_ROOT="$(dirname "$(dirname "$RESOLVED_BIN")")"
export AX_ROOT
export AX_LIB="$AX_ROOT/lib"
export AX_TEMPLATES="$AX_ROOT/templates"

say() { printf "\033[36m[ax-first]\033[0m %s\n" "$*"; }
warn() { printf "\033[33m[ax-first]\033[0m %s\n" "$*" >&2; }
die() { printf "\033[31m[ax-first]\033[0m %s\n" "$*" >&2; exit 1; }
export -f say warn die

usage() {
    cat <<EOF
ax-first $VERSION — AI Agent Harness Framework

Commands:
  init [--preset <name>] [--force]   현재 프로젝트에 하네스 골격 설치
  triage <설명>                       작업을 Size×Risk로 분류
  audit                              .ax-first/mistakes/ 스캔 + 룰 승격 후보
  doctor                             하네스 상태 진단 (결손 항목 리포트)
  update                             ax-first 자체 업데이트
  help                               이 도움말
  version                            버전 출력

Docs: https://github.com/bluecheat/ax/blob/main/docs/concepts.md
EOF
}

cmd="${1:-help}"
shift || true

case "$cmd" in
    init)     exec "$AX_ROOT/bin/ax-first-init" "$@" ;;
    triage)   exec "$AX_ROOT/bin/ax-first-triage" "$@" ;;
    audit)    exec "$AX_ROOT/bin/ax-first-audit" "$@" ;;
    doctor)   exec "$AX_ROOT/bin/ax-first-doctor" "$@" ;;
    update)   exec "$AX_ROOT/bin/ax-first-update" "$@" ;;
    version|--version|-v) echo "ax-first $VERSION" ;;
    help|--help|-h) usage ;;
    *) die "알 수 없는 명령: $cmd (ax-first help)" ;;
esac
